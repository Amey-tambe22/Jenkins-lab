pipeline{
    agent any

    tools{
        maven 'mymaven'
    }
    stages{
        stage('parallel stage'){
            parallel{
                stage('Compile'){
                    steps{
                        git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
                        sh 'mvn compile'
                    }
                }
                stage('Code Review'){
                    steps{
                        sh 'mvn pmd:pmd'
                    }
                }
            }
        }
    }
}
