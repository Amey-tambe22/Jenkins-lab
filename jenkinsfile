pipeline{
    agent any
    
    tools {
        maven 'mymaven'
    }
    stages{
        parallel {
            stage('Compile'){
                steps{
                    git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
                    sh 'mvn compile'
                }
                stage('Test'){
                    steps{
                        sh 'mvn test'
                    }
                }
            }
        }
    }
}